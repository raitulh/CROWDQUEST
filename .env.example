APP_NAME=CrowdQuest AI
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
TOKEN_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false
COOKIE_DOMAIN=
ACCESS_TOKEN_TTL_MINUTES=10080

POSTGRES_DB=crowdquest
POSTGRES_USER=crowdquest
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://crowdquest:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/crowdquest
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
REDIS_PREFIX=crowdquest

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/api/v1/auth/twitch/callback
TWITCH_SCOPES=["user:read:chat","user:write:chat"]
TWITCH_EVENTSUB_URL=wss://eventsub.wss.twitch.tv/ws
TWITCH_WORKER_POLL_SECONDS=12
TWITCH_RECONNECT_BACKOFF_MAX_SECONDS=60

AI_PROVIDER=ollama
AI_TIMEOUT_SECONDS=45
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

SESSION_COOKIE_NAME=cq_session
OAUTH_STATE_TTL_SECONDS=600
WEBSOCKET_HEARTBEAT_SECONDS=25
VOTING_MIN_SECONDS=15
VOTING_MAX_SECONDS=180
CHAT_USER_COOLDOWN_SECONDS=3
TWITCH_CHAT_RESPONSE_COOLDOWN_SECONDS=1.5
MAX_CHAT_MESSAGE_LENGTH=500
PROCESSED_EVENT_RETENTION_DAYS=30
SESSION_EVENT_RETENTION_DAYS=180
LOG_LEVEL=INFO

API_PORT=127.0.0.1:8000
WEB_PORT=127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
